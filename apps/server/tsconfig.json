{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "incremental": true,
    "composite": false,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./web/src/*"],
      "pg-boss": ["../../node_modules/pg-boss/types"]
    }
  },
  "include": ["src/**/*", "web/**/*", ".next/types/**/*"],
  "exclude": ["node_modules", "dist", ".next"]
}
